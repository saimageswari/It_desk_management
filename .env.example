# Use a dedicated MySQL database. URL format:
# mysql+pymysql://helpdesk:change-me@localhost:3306/helpdesk_db?charset=utf8mb4
DATABASE_URL=mysql+pymysql://helpdesk:replace-with-a-unique-secret@localhost:3306/helpdesk_db?charset=utf8mb4
APP_ENV=development
BOOTSTRAP_ADMIN_NAME=Helpdesk Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
BOOTSTRAP_ADMIN_PASSWORD=
